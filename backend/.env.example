NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or local) and the database to use
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=lms

# Use a long random string (at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_EXPIRES_IN=1d

# Origin of the Next.js frontend (used for CORS)
CLIENT_URL=http://localhost:3000

# Directory where uploaded salary slips are stored
UPLOAD_DIR=uploads
